
pragma cashscript ^0.14.0;

contract GroupVault(
    bytes20 beneficiary,
    int targetAmount
) {
    function settle() {
        require(targetAmount > 546);

        // Limit the number of inputs to keep script execution bounded.
        require(tx.inputs.length >= 1);
        require(tx.inputs.length <= 10);

        int minerFee = 1000;
        int totalInputValue = 0;

        // All inputs must belong to this same GroupVault.
        for (int i = 0; i < tx.inputs.length; i++) {
            require(
                tx.inputs[i].lockingBytecode ==
                tx.inputs[this.activeInputIndex].lockingBytecode
            );

            totalInputValue += tx.inputs[i].value;
        }

        require(
            totalInputValue == targetAmount + minerFee
        );

        require(tx.outputs.length == 1);

        bytes25 beneficiaryLockingBytecode =
            new LockingBytecodeP2PKH(beneficiary);

        require(
            tx.outputs[0].lockingBytecode ==
            beneficiaryLockingBytecode
        );

        require(tx.outputs[0].value == targetAmount);
    }
}
